{
    "version": "1.0.4",
    "description": "EmailGuard public API PHP SDK. See https://emailguard.co/docs/api-reference/guides/sdk-php for setup, authentication, and examples.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://emailguard.co",
    "license": "unlicense",
    "authors": [
        {
            "name": "EmailGuard",
            "email": "dev@emailguard.co"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "emailguardSdk\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "emailguardSdk\\Test\\": "test/"
        }
    },
    "name": "emailguard/emailguard-sdk"
}
